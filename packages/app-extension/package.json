{
  "name": "@quasar/quasar-app-extension-qscroller",
  "version": "3.0.1",
  "description": "QScroller is an app extension for Quasar for string, time, date, and range scrollers",
  "keywords": [
    "app",
    "app extension",
    "date",
    "extension",
    "quasar",
    "quasarframework",
    "range",
    "scroller",
    "time"
  ],
  "homepage": "https://github.com/quasarframework/quasar-ui-qscroller",
  "bugs": "https://github.com/quasarframework/quasar-ui-qscroller/issues",
  "license": "MIT",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar-ui-qscroller.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkeye64"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#q-app": "@quasar/app-vite"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "lint": "oxlint src",
    "release": "pnpm publish --tag latest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@quasar/quasar-ui-qscroller": "workspace:^"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.6.0",
    "quasar": "^2.25.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@quasar/app-vite": ">=3.0.0"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.5.0"
  }
}
